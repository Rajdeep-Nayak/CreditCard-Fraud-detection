FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN pip install mlflow==3.17.1

RUN useradd --create-home appuser && mkdir /mlflow && chown appuser /mlflow
USER appuser
WORKDIR /mlflow

EXPOSE 5000
# artifacts are proxied through the server, so clients on the host need no shared volume
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", \
     "--backend-store-uri", "sqlite:////mlflow/mlflow.db", \
     "--artifacts-destination", "/mlflow/artifacts", "--serve-artifacts"]
